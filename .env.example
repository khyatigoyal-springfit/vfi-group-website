# VFI Group website: environment variables. Copy to .env or set them in Vercel (Production + Preview).
# NEVER commit real values.
# Generate secrets with:  openssl rand -hex 32

# Local server port (server.js only)
PORT=3000

# --- Database (Neon Postgres, added through Vercel > Storage). Leave empty ONLY for local development: the
# in-memory store is used (content edits and users are lost on restart). On Vercel / NODE_ENV=production a missing
# DATABASE_URL makes enquiry and admin endpoints answer 503 "unavailable" and /api/content serve the bundled defaults.
# Tables are created automatically on first use (no manual migration step).
DATABASE_URL=

# --- Image uploads (Vercel Blob store, added through Vercel > Storage). Without it the Media library answers
# 503 "media_not_configured"; everything else keeps working. ---
BLOB_READ_WRITE_TOKEN=

# --- Admin panel (/admin) ---
# Signs the admin session cookie, at least 32 characters (openssl rand -hex 32 gives 64). If missing or too short the admin
# API answers 503 admin_not_configured. Changing it logs everyone out.
SESSION_SECRET=replace-with-openssl-rand-hex-32
# First administrator, created ONLY when the users table is empty. The account must change this password at first login.
# Remove both variables after the first login.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-passphrase-of-12-or-more-characters

# Salt for hashing visitor IPs (raw IPs are never stored)
IP_SALT=replace-with-openssl-rand-hex-32

# Client IP trust (rate limiting). On Vercel the platform headers are used automatically.
# Off Vercel (server.js) the socket address is used; set TRUST_PROXY=1 ONLY when behind a reverse proxy you control
# that overwrites X-Forwarded-For (otherwise clients can spoof it to evade rate limits).
# TRUST_PROXY=1

# --- Optional email notification for each enquiry ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recipient and sender addresses
ENQUIRY_TO=business@example.com
ENQUIRY_FROM=website@example.com

# --- Local/testing only ---
# Override where the memory store saves enquiries (default ./data/enquiries.json; not used on Vercel)
# ENQUIRY_DATA_FILE=/tmp/enquiries.json
# Postgres integration tests (npm test): a THROWAWAY database; its public schema is dropped and recreated.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/vfi_test

# --- Set by the platform, listed for completeness (do not set on Vercel) ---
# NODE_ENV=production   (cookie gets Secure outside localhost)
# VERCEL=1              (disables file persistence of the memory store)
