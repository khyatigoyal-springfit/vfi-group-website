# VFI Group website: environment variables. Copy to .env or set them in Vercel (Production + Preview).
# NEVER commit real values.
# Generate secrets with:  openssl rand -hex 32

# Local server port (server.js only)
PORT=3000

# --- Supabase (leave SUPABASE_URL empty ONLY for local dev: the memory/file store). On Vercel / NODE_ENV=production a missing
# SUPABASE_URL or SUPABASE_ANON_KEY makes every store call fail closed (503 unavailable), never the memory store. ---
# Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# Publishable (anon) key from Project Settings > API. Server-side only, never sent to the browser.
SUPABASE_ANON_KEY=
# Random secret whose SHA-256 hash is stored in private.app_secrets (see README). Needed for ALL RPCs, including
# submit_enquiry (migration 0002), so the public anon key alone cannot insert rows.
SUPABASE_ADMIN_SECRET=replace-with-openssl-rand-hex-32

# --- Admin dashboard (/admin). If either is missing or too short, admin login is refused (503 admin_not_configured) ---
# The single admin password, at least 12 characters. Changing it logs out all existing admin sessions.
ADMIN_PASSWORD=replace-with-a-long-passphrase
# Signs the admin session cookie, at least 32 characters (openssl rand -hex 32 gives 64). Changing it logs everyone out.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Salt for hashing visitor IPs (raw IPs are never stored)
IP_SALT=replace-with-openssl-rand-hex-32

# Client IP trust (rate limiting). On Vercel the platform headers are used automatically.
# Off Vercel (server.js) the socket address is used; set TRUST_PROXY=1 ONLY when behind a reverse proxy you control
# that overwrites X-Forwarded-For (otherwise clients can spoof it to evade rate limits).
# TRUST_PROXY=1

# --- Optional email notification for each enquiry ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recipient and sender addresses
ENQUIRY_TO=business@example.com
ENQUIRY_FROM=website@example.com

# --- Local/testing only ---
# Override where the memory store saves enquiries (default ./data/enquiries.json; not used on Vercel)
# ENQUIRY_DATA_FILE=/tmp/enquiries.json

# --- Set by the platform, listed for completeness (do not set on Vercel) ---
# NODE_ENV=production   (cookie gets Secure outside localhost)
# VERCEL=1              (disables file persistence of the memory store)
